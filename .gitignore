# Spell Tracker — gitignore
# Стандартный Android Studio + доп.правила для проекта.

# === Сборка ===
.gradle/
build/
**/build/
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
release/

# === Локальная конфигурация ===
local.properties

# === Локальные данные Qwen Code (скиллы, memory, settings) ===
# Не относятся к проекту — генерируются локально.
.qwen/

# === Локальные инструменты (не для публичного репо) ===
# Скрипты tools/ — рабочие утилиты разработчика, в репозиторий не идут.
# QWEN.md — контекст для Qwen Code (только для локального использования).
tools/*.ps1
tools/*.py
QWEN.md

# === Логи ===
*.log

# === Android Studio ===
# Игнорируем .idea/ целиком — пользовательские настройки IDE,
# в репозиторий они не нужны. Правила ниже — на случай, если
# в будущем понадобится коммитить часть .idea/.
.navigation/
captures/
*.iml
.idea/

# === Proguard ===
proguard/

# === Ключи и секреты ===
# Этап 23: релизный keystore + файл с паролями. НЕ коммитим.
*.jks
*.keystore
keystore/
keystore.properties
# Этап 23: base64-строки для GitHub Secrets (для CI подписи).
# Не должны попасть в репозиторий — регенерируются из keystore/.
secrets/
google-services.json

# === Нативная сборка ===
.externalNativeBuild
.cxx/

# === Локальная документация (не для публичного репо) ===
STATUS.md

# === Разное ===
.DS_Store
Thumbs.db
vcs.xml
build_log.txt  
build_compose.log  
build_log.txt  

# Diagnostic Python scripts (not part of build)
analyze_assets.py
analyze_result.txt
check_levels.py
patch_spells_screen.py
debug_regex.py
inspect_*.py
verify_patch.py
build.log

# === Локальные инструменты инспекции APK (не для публичного репо) ===
apk_inspect/
apk_inspect.zip
