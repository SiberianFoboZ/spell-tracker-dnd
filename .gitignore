# Spell Tracker — gitignore
# Стандартный Android Studio + доп.правила для проекта.

# === Сборка ===
.gradle/
build/
**/build/
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
release/

# === Локальная конфигурация ===
local.properties

# === Логи ===
*.log

# === Android Studio ===
# Игнорируем .idea/ целиком — пользовательские настройки IDE,
# в репозиторий они не нужны. Правила ниже — на случай, если
# в будущем понадобится коммитить часть .idea/.
.navigation/
captures/
*.iml
.idea/

# === Proguard ===
proguard/

# === Ключи и секреты ===
*.jks
*.keystore
google-services.json

# === Нативная сборка ===
.externalNativeBuild
.cxx/

# === Локальная документация (не для публичного репо) ===
STATUS.md

# === Разное ===
.DS_Store
Thumbs.db
vcs.xml
build_log.txt  
build_compose.log  
build_log.txt  
