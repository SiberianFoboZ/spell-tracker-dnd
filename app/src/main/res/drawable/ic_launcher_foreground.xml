<?xml version="1.0" encoding="utf-8"?>
<!--
  Передний план иконки: открытая книга заклинаний (spellbook) + золотая
  4-конечная звезда-спarkle сверху. Цвет страниц кремовый (#F4E4C1),
  контуры и «текст» — тёмно-фиолетовые (#2A0E3F). viewport 108x108.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Малая верхняя искра слева -->
    <path
        android:fillColor="#F4C430"
        android:fillAlpha="0.55"
        android:pathData="M22,32 L24,38 L30,40 L24,42 L22,48 L20,42 L14,40 L20,38 Z" />

    <!-- Малая верхняя искра справа -->
    <path
        android:fillColor="#F4C430"
        android:fillAlpha="0.55"
        android:pathData="M86,32 L88,38 L94,40 L88,42 L86,48 L84,42 L78,40 L84,38 Z" />

    <!-- Большая 4-конечная звезда над книгой -->
    <path
        android:fillColor="#F4C430"
        android:pathData="M54,20 L58,38 L76,42 L58,46 L54,64 L50,46 L32,42 L50,38 Z" />

    <!-- Левая страница (трапеция, чуть выше у корешка) -->
    <path
        android:fillColor="#F4E4C1"
        android:strokeColor="#2A0E3F"
        android:strokeWidth="1.4"
        android:pathData="M28,52 L54,48 L54,84 L28,80 Z" />

    <!-- Правая страница -->
    <path
        android:fillColor="#F4E4C1"
        android:strokeColor="#2A0E3F"
        android:strokeWidth="1.4"
        android:pathData="M54,48 L80,52 L80,80 L54,84 Z" />

    <!-- «Текст» на левой странице -->
    <path android:strokeColor="#2A0E3F" android:strokeWidth="0.9" android:pathData="M34,60 L48,58" />
    <path android:strokeColor="#2A0E3F" android:strokeWidth="0.9" android:pathData="M34,65 L48,63" />
    <path android:strokeColor="#2A0E3F" android:strokeWidth="0.9" android:pathData="M34,70 L46,68" />
    <path android:strokeColor="#2A0E3F" android:strokeWidth="0.9" android:pathData="M34,75 L48,73" />

    <!-- «Текст» на правой странице -->
    <path android:strokeColor="#2A0E3F" android:strokeWidth="0.9" android:pathData="M60,58 L74,60" />
    <path android:strokeColor="#2A0E3F" android:strokeWidth="0.9" android:pathData="M60,63 L74,65" />
    <path android:strokeColor="#2A0E3F" android:strokeWidth="0.9" android:pathData="M62,68 L74,70" />
    <path android:strokeColor="#2A0E3F" android:strokeWidth="0.9" android:pathData="M60,73 L74,75" />
</vector>
