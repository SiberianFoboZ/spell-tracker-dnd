<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules для Android Auto Backup (API < 31).
   См. https://developer.android.com/guide/topics/data/autobackup
   Документ Этап 23: бэкапим ВСЕ SharedPreferences, чтобы при
   uninstall+reinstall (например, при смене signing key между версиями,
   v2.4.2 debug-keystore → v2.5.0 release-keystore) данные выжили.
-->
<full-backup-content>
    <!-- Весь SharedPreferences включая spell_tracker (классы, ячейки,
         арканумы, кастомные ячейки, подготовленные заклинания,
         список персонажей и активный id). -->
    <include domain="sharedpref" path="."/>
</full-backup-content>