<?xml version="1.0" encoding="utf-8"?>
<!-- Строка заклинания: тёмный фон, золотой номер уровня. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_class_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/slot_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/text_white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/slot_subtitle"
                android:textSize="12sp"
                android:textColor="@color/text_grey" />
        </LinearLayout>

        <TextView
            android:id="@+id/slot_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/gold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btn_use"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="@string/btn_use"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/gold"
            android:background="@drawable/bg_button_action"
            android:layout_marginEnd="6dp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btn_restore"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:text="@string/btn_restore"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/gold"
            android:background="@drawable/bg_button_action"
            android:layout_marginStart="6dp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
