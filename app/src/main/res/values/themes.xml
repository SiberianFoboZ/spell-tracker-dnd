<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Тёмная тема: фиолетовый + золото, в стиле мокапов. -->
    <style name="Theme.SpellTracker" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/purple</item>
        <item name="colorPrimaryVariant">@color/purple_light</item>
        <item name="colorOnPrimary">@color/text_white</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorSecondaryVariant">@color/gold</item>
        <item name="colorOnSecondary">@color/bg_dark</item>

        <!-- Фон окна — радиальный градиент (см. bg_screen_gradient). -->
        <item name="android:windowBackground">@drawable/bg_screen_gradient</item>
        <!-- Status / nav bar прозрачные, чтобы было edge-to-edge. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Текстовые цвета по умолчанию. -->
        <item name="android:textColorPrimary">@color/text_white</item>
        <item name="android:textColorSecondary">@color/text_grey</item>
        <item name="android:textColorTertiary">@color/text_grey_dark</item>
    </style>

    <!-- Карточка класса в сетке 3×3. -->
    <style name="ClassCardStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">84dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">6dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Имя класса в карточке (мелкий серый текст). -->
    <style name="ClassNameStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_grey</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Поле ввода уровня класса (большой золотой номер). -->
    <style name="ClassInputStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">2</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textColorHint">@color/text_grey_dark</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@null</item>
        <item name="android:minWidth">36dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
