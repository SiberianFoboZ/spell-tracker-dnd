# Шаблон keystore.properties. Скопируйте в keystore.properties и
# подставьте свои значения. keystore.properties в .gitignore —
# реальные пароли не должны попадать в репозиторий.
#
# 1) Сгенерируйте keystore (если ещё нет):
#    .\tools\generate_keystore.ps1
#    либо вручную:
#    keytool -genkeypair -v -keystore keystore/spell-tracker-release.jks ^
#            -alias spell-tracker -keyalg RSA -keysize 2048 -validity 10000 ^
#            -storepass <STORE_PASSWORD> -keypass <KEY_PASSWORD> ^
#            -dname "CN=Spell Tracker, OU=Personal, O=vk241, C=RU"
#
# 2) Заполните поля ниже. keyPassword == storePassword для PKCS12.
#
# 3) Никогда не коммитьте реальный keystore.properties — только .example.

storeFile=keystore/spell-tracker-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=spell-tracker
keyPassword=YOUR_KEY_PASSWORD